{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "strict": false,
    "jsx": "react-native",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "lib": ["es2017", "dom", "esnext"],
    "types": ["react-native"],
    "paths": {
      "@/*": ["./*"],
      "@homeops/shared": ["../../packages/shared/src"],
      "@homeops/shared/*": ["../../packages/shared/src/*"],
      "@homeops/supabase": ["../../packages/supabase/src"],
      "@homeops/supabase/*": ["../../packages/supabase/src/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "types/**/*.d.ts",
    "types/routes.d.ts",
    "global.d.ts"
  ]
}
